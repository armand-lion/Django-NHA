{
  "explorer.compactFolders": false,
  "editor.snippetSuggestions": "top",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1500,
  "emmet.showExpandedAbbreviation": "always",
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,

  // Wereldwijde tabgrootte (Nu op 2 gezet, wat de standaard is voor React/HTML)
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // Python fallback
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvInCurrentTerminal": true,
    "python.experiments.optOutFrom": [
    "pythonTerminalEnvVarActivation"
  ],

  // Globale HTML-formatter instellingen (Ingebouwde VS Code formatter)
  "html.format.unformatted": "",
  "html.format.indentInnerHtml": true,

  // Hiermee dwingt u af dat de ingebouwde HTML-formatter van VS Code wordt gebruikt voor HTML-bestanden, in plaats van Prettier.
  // De ingebouwde formatter laat de DOCTYPE in hoofdletters staan en gebruikt géén zelfsluitende streepjes.
  "[html]": {
    // "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  },

  // Zorg dat VS Code Django-templates herkent en geef ze een tabgrootte van 4 (net als Python)
  "[django-html]": {
    "editor.defaultFormatter": "batisteo.vscode-django",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  },

  // zorg dat VS Code Blade-bestanden herkent en formatteert
  "bladeFormatter.format.enabled": true,
  "bladeFormatter.format.indentInnerHtml": true,
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    "editor.formatOnSave": true,
    "editor.autoClosingBrackets": "always",
    "editor.tabSize": 4
  },

  // Laravel pint formaters php code volgens officiele laravel-team
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
  },

  // Pyhton formatter
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },

  // Prettier formatter instellen voor React
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // Pretier formatter algemeen
  "prettier.singleQuote": true,
  "prettier.singleAttributePerLine": true,

  // Voor Tailwind v4 live preview
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // Zorgt dat Emmet bij het typen direct de React/XHTML-stijl aanhoudt (dus mét />)
  "emmet.preferences": {
    "selfClosingStyle": "xhtml"
  },

  //Emmet activeren voor React (JSX) + EJS voor html
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "ejs": "html",
    "django-html": "html"
  },

  // ESLint validator
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  "eslint.validate": ["javascript", "typescript", "vue"],

  // Als u HTMLHint gebruikt, horen deze regels direct in de hoofdmap van de JSON te staan
  "htmlhint.options": {
    "doctype-first": true,
    "doctype-html5": true
  },

  "task.allowAutomaticTasks": "on",

  // Schakel de ingebouwde PHP-suggesties uit om conflicten met Intelephense te voorkomen
  "php.suggest.basic": false,
  "php.validate.enable": false,

  // Pas deze regel aan naar je de CSS-locatie:
  "tailwindCSS.experimental.configFile": "src/index.css",

  // Dwing VS Code om suggesties te tonen zodra je in een HTML class="" typt
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": true
  },

  // Zorg dat autocomplete direct reageert bij het typen van een letter of een koppelteken (zoals bg-)
  "editor.suggestOnTriggerCharacters": true,

  // Koppel pure HTML-bestanden expliciet aan de actieve Tailwind v4-server
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "plaintext": "html",
    "javascriptreact": "html",
    "django-html": "html"
  },

  // Voorkom dat andere HTML-formatters de autocomplete-lijst wegdrukken
  "tailwindCSS.emmetCompletions": true,

  // --- C_SPELL INSTELLINGEN ---
  // Controleer zowel Engelse code/klassen als Nederlandse teksten en opmerkingen
  "cSpell.language": "en,nl",

  // Activeer de juiste ingebouwde woordenboeken voor webontwikkeling
  "cSpell.dictionaries": [
    "softwareTerms",
    "html",
    "css",
    "fonts",
    "lorem-ipsum",
    "django"
  ],

  // DE LIFESAVER: Negeer ALLES wat binnen class="..." of className="..." staat (geen Tailwind-fouten meer)
  "cSpell.ignoreRegExpList": ["class=\"[^\"]*\"", "className=\"[^\"]*\""],

  //  Belangrijke Intelephense instellingen voor Laravel helper-functies
  "intelephense.associations.fileMatch": ["*.php"],
  "intelephense.environment.phpVersion": "8.5", // Pas aan naar jouw PHP-versie
  "intelephense.diagnostics.undefinedTypes": false, // Voorkomt valse foutmeldingen bij Laravel Facades

  // Bestanden en mappen verbergen die je zelden handmatig aanpast (schonere zijbalk)
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/vendor": true
  },

  // Colorful Comments Styling
  "colorful-comments-refreshed.multilineComments": true,
  "colorful-comments-refreshed.highlightPlainText": false,
  "colorful-comments-refreshed.tags": [
    {
      "tag": "!",
      "color": "#FF2D00",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "?",
      "color": "#0076FF",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "//",
      "color": "#474747",
      "strikethrough": true,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "`",
      "color": "#EAF622",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "*",
      "color": "#28FF00",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "&",
      "color": "#FF06A0",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "~",
      "color": "#BE00FF",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "todo",
      "color": "#FF8C00",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    }
  ],

  // Millisecond delay for update decorations, default 0
  "better-comments.updateDelay": 0,
  // Preload lines outside the visible window for better performance, default 100
  "better-comments.preloadLines": 100,
  // Enable/disable highlight plain text.
  "better-comments.highlightPlainText": false,
  // Highlight entire line of line comment
  "better-comments.fullHighlight": false,
  // Strict mode of tag matching. Default true
  "better-comments.strict": true,
  // Custom languages comments configuration
  "better-comments.languages": [
    // {
    //   "id": "proto3", // (Required) Language ID
    //   "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] }, // (Optional) Comment Syntax
    //   "embeddedLanguages": [], // (Optional) Embedded Languages. Example for HTML: ["css", "javascript"]
    //   "useDocComment": false // (Optional) Use Doc Comments
    // }
    {
      "id": "blade",
      "comments": {
        "blockComment": ["{{--", "--}}"]
      },
      "embeddedLanguages": ["blade", "php"]
    }
  ],

  // Overwrite the specified tag styles of `"better-comments.tags"` for light themes.
  "better-comments.tagsLight": [],
  // Overwrite the specified tag styles of `"better-comments.tags"` for dark themes.
  "better-comments.tagsDark": [],

  // Tags for decoration.
  "better-comments.tags": [
    {
      "tag": "#",
      "color": "#18b566",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": true,
      "italic": false
    },
    {
      "tag": "!",
      "color": "#FF2D00",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "?",
      "color": "#3498DB",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "//",
      "color": "#474747",
      "strikethrough": true,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": ["todo", "to-do"],
      "color": "#FF8C00",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false,
      "multiline": true
    },
    {
      "tag": "*",
      "color": "#98C379",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "bug",
      "color": "#E84393",
      "strikethrough": false,
      "underline": true,
      "backgroundColor": "#FDA7DF20",
      "bold": true,
      "italic": false
    },
    {
      "tag": "hack",
      "color": "#9B59B6",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "#9B59B620",
      "bold": true,
      "italic": true
    },
    {
      "tag": ["fixme", "fix-me", "fix"],
      "color": "#FD79A8",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "#FD79A820",
      "bold": true,
      "italic": false
    },
    {
      "tag": ["fixme", "fix-me", "fix"],
      "color": "#FD79A8",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "#FD79A820",
      "bold": true,
      "italic": false
    }
  ],
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "punctuation.definition.comment.blade",
          "punctuation.definition.comment.html",
          "punctuation.definition.comment.xml"
        ],
        "settings": {
          // Verander dit naar jouw favoriete kleur voor de tags (bijv. donkergrijs of groen)
          "foreground": "#6A737D",
          "fontStyle": "italic"
        }
      }
    ]
  },

  "better-todo-tree.tree.showBadges": true,
  "better-todo-tree.tree.showCountsInTree": true,
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
